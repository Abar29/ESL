{
    "functions": {
        "public/index.php": {
            "runtime": "@vercel/php",
            "includeFiles": [
                "vendor/**",
                "bootstrap/**",
                "config/**",
                "app/**",
                "routes/**",
                "database/**",
                "resources/**",
                "public/**"
            ]
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/storage/(.*)",
            "dest": "/public/storage/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.php"
        }
    ]
}
